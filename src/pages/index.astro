---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kadabra Labs — AI munkafolyamat automatizálás',
  ignoreTitleTemplate: true,
};

const headerData = {
  links: [
    { text: 'Szolgáltatások', href: '/#services' },
    { text: 'Hogyan dolgozunk', href: '/#how-we-work' },
    { text: 'EN', href: '/en' },
    { text: 'HU', href: '/' },
  ],
  actions: [{ text: 'Ingyenes AI Konzultáció', href: 'https://cal.com/kadabralabs/15min', target: '_blank' }],
};

const footerData = {
  links: [
    {
      title: 'Kapcsolat',
      links: [{ text: 'hello@kadabra-labs.com', href: 'mailto:hello@kadabra-labs.com' }],
    },
  ],
  secondaryLinks: [
    { text: 'Felhasználási feltételek', href: '/terms' },
    { text: 'Adatkezelési tájékoztató', href: '/privacy' },
  ],
  socialLinks: [],
  footNote: '© 2026 Kadabra Labs Kft. · Budapest, Magyarország',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} isSticky showToggleTheme />
  </Fragment>
  <Fragment slot="footer">
    <Footer {...footerData} />
  </Fragment>

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Ingyenes AI Konzultáció',
        href: 'https://cal.com/kadabralabs/15min',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">AI ami a cégedért dolgozik — nem fordítva</Fragment>

    <Fragment slot="subtitle">
      A Kadabra Labs cégeknek épít AI-alapú automatizmusokat: bejövő e-mailek, dokumentumok és üzleti folyamatok
      gyorsítására. Gyuris Krisztián vezetésével, budapesti központtal, 15+ év vállalati szoftveres tapasztalattal.
    </Fragment>
  </Hero>

  <Features
    id="services"
    tagline="Szolgáltatások"
    title="Miben segítünk"
    subtitle="Jól körülhatárolt scope, fix árazás, és kézzelfogható üzleti eredmény."
    items={[
      {
        title: 'AI asszisztens a weboldaladra',
        description:
          'A céges tudásbázisodra tanított chatbot, ami gyors és pontos válaszokat ad az érdeklődőknek és ügyfeleknek.',
        icon: 'tabler:robot',
      },
      {
        title: 'E-mail és dokumentum automatizálás',
        description:
          'Bejövő e-mailek feldolgozása, valamint számlák és szerződések adatkinyerése a meglévő rendszereidbe.',
        icon: 'tabler:mail',
      },
      {
        title: 'Egyedi workflow automatizálás',
        description:
          'n8n + AI integrációk, amelyek összekötik az eszközeidet és kiváltják az ismétlődő manuális lépéseket.',
        icon: 'tabler:arrows-shuffle',
      },
    ]}
  />

  <Steps
    id="how-we-work"
    title="Hogyan dolgozunk"
    items={[
      {
        title: 'Ismerkedő hívás',
        description: 'Átbeszéljük a jelenlegi folyamataidat, és azonosítjuk, hol hoz gyors nyereséget az automatizálás.',
        icon: 'tabler:phone-call',
      },
      {
        title: 'Ajánlat és terv',
        description: 'Egyértelmű ajánlatot kapsz scope-pal, ütemezéssel és fix árral, rejtett tételek nélkül.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Fejlesztés és átadás',
        description: 'Megépítjük, leteszteljük és működően átadjuk az automatizmust, dokumentációval együtt.',
        icon: 'tabler:tools',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Ingyenes AI Konzultáció',
        href: 'https://cal.com/kadabralabs/15min',
        target: '_blank',
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">Foglalj egy ingyenes AI konzultációt</Fragment>

    <Fragment slot="subtitle">
      15 perc alatt átbeszéljük, hol spórolhatsz időt és pénzt AI automatizálással.
    </Fragment>
  </CallToAction>
</Layout>
