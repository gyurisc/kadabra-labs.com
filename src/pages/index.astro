---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kadabra Labs - AI Workflow Automatizálás',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Book a Call',
        href: 'https://cal.com/kadabralabs/15min',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Automatizáld a céged AI-val — heteken belül, nem hónapok alatt</Fragment>

    <Fragment slot="subtitle">
      AI workflow automatizálás magyar vállalkozásoknak. Csökkentsd a manuális munkát, növeld a hatékonyságot. 15+
      év szoftver tapasztalat, fix árazás.
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="services"
    tagline="Szolgáltatások"
    title="Miben segítünk"
    subtitle="Egyszerű, gyorsan bevezethető AI automatizálások, valós üzleti eredményekkel."
    items={[
      {
        title: 'AI Chatbot a weboldaladra',
        description:
          'Ügyfélszolgálati chatbot ami a céged tudásbázisából válaszol. Kevesebb email, gyorsabb válaszok, elégedettebb ügyfelek.',
        icon: 'tabler:message-chatbot',
      },
      {
        title: 'Email és dokumentum automatizálás',
        description:
          'Bejövő emailek feldolgozása, számlák, ajánlatkérések automatikus kategorizálása és feldolgozása.',
        icon: 'tabler:mail-fast',
      },
      {
        title: 'Egyedi workflow automatizálás',
        description:
          'Ismétlődő feladatok automatizálása n8n-nel és AI-val. Ami eddig órákat vett el, az percek alatt kész.',
        icon: 'tabler:arrows-shuffle',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Így dolgozunk"
    items={[
      {
        title: 'Ingyenes konzultáció',
        description:
          '15 perces beszélgetés, megértjük mit szeretnél automatizálni.',
        icon: 'tabler:phone-call',
      },
      {
        title: 'Ajánlat fix áron',
        description:
          'Pontos scope, határidő és ár. Nincs meglepetés.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Elkészül 1-2 hét alatt',
        description:
          'Gyors delivery, heti demo. Nem hónapokig tartó projekt.',
        icon: 'tabler:tools',
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Gyakran Ismételt Kérdések"
    subtitle=""
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Mennyibe kerül?',
        description:
          'A projektek jellemzően 300.000 - 2.000.000 Ft között mozognak a scope-tól függően. Az első konzultáció után fix áras ajánlatot adunk.',
      },
      {
        title: 'Mennyi idő alatt készül el?',
        description:
          'A legtöbb automatizálási projekt 1-2 hét alatt elkészül. Nem hónapokig tartó fejlesztés.',
      },
      {
        title: 'Milyen cégeknek ajánljátok?',
        description:
          'Kis és közepes vállalkozásoknak akik manuális, ismétlődő feladatokat szeretnének automatizálni AI segítségével.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a Call',
        href: 'https://cal.com/kadabralabs/15min',
        target: '_blank',
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">Beszéljünk!</Fragment>

    <Fragment slot="subtitle">
      Foglalj egy ingyenes 15 perces konzultációt. Semmi kötelezettség — csak egy beszélgetés arról, hogyan segíthet
      az AI a cégednek.
    </Fragment>
  </CallToAction>
</Layout>
